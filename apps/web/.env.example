# 正式部署时填写站点公开地址，供 robots.txt 和 sitemap.xml 使用。
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 公开测试时填写，用于“联系与纠错”页面。
NEXT_PUBLIC_CONTACT_EMAIL=feedback@your-domain.example

# 仅在公开部署运营后台时填写；本地不填写即可直接访问。
# 浏览器会弹出 Basic Auth，访问 /ops、/ops/review 和 /ops/review-queue。
OPS_USER=ops
OPS_PASSWORD=change-this-before-public-deploy
