{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:import": "node scripts/import-v12.mjs",
    "data:check": "node scripts/validate-catalog.mjs",
    "data:verify": "pnpm data:import && pnpm data:check && pnpm data:review",
    "data:review": "node scripts/generate-review-queue.mjs",
    "data:health": "node scripts/data-health.mjs",
    "data:preflight": "node scripts/data-preflight.mjs",
    "source:scan:bytedance": "node scripts/scan-bytedance-campus.mjs",
    "source:review": "node scripts/generate-source-review-queue.mjs",
    "source:review:check": "node scripts/validate-source-review-decisions.mjs",
    "source:maintenance:preview": "node scripts/generate-source-maintenance-preview.mjs",
    "smoke:check": "node scripts/smoke-check.mjs",
    "data:prepare:v13": "node scripts/prepare-v13-release.mjs",
    "data:prepare:v14": "node scripts/prepare-v14-release.mjs",
    "data:verify:v14": "pnpm data:import -- --version=V1.4 && pnpm data:check -- --version=V1.4 && pnpm data:review",
    "release:check:v14": "pnpm data:prepare:v14 && pnpm data:verify:v14 && pnpm data:health && pnpm lint && pnpm build",
    "release:check": "pnpm data:prepare:v13 && pnpm data:verify && pnpm data:health && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}



